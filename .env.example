# ─────────────────────────────────────────────────────────────
# Store storefront — public environment template
# Copy this file to .env.local for local development.
#
# Only NEXT_PUBLIC_* values belong in this frontend. Payment provider
# secrets (Stripe secret key, bKash/Nagad credentials) live in the Express
# backend's environment and must never be exposed here.
#
# Active values below are LOCAL DEVELOPMENT defaults. After `vercel --prod`
# generates the new links, fill the PLACEHOLDERS below in Vercel Project
# Settings -> Environment Variables, then redeploy. NEXT_PUBLIC_* values are
# inlined at build time, so the URLs must be present BEFORE the build runs.
# No OpenAI / AI packages are used by this client.
# ─────────────────────────────────────────────────────────────

# Base URL of the Express API (all requests are made directly from the browser).
# Vercel: NEXT_PUBLIC_API_URL=https://<NEW_SERVER_VERCEL_URL>/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical site URL used for metadata, sitemap and auth redirects.
# Vercel: NEXT_PUBLIC_SITE_URL=https://<NEW_CLIENT_VERCEL_URL>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Left blank on purpose: the store name is read from Dashboard -> Settings
# at runtime. Fallback branding stays generic until settings load.
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
NEXT_PUBLIC_CONTACT_PHONE=+880 1000 000000
NEXT_PUBLIC_STORE_ADDRESS=Dhaka, Bangladesh

# Pricing display. API amounts are in the base currency (BDT).
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_BASE_CURRENCY=BDT
NEXT_PUBLIC_USD_TO_BDT=120

# Shipping rules. Keep these in sync with the backend defaults.
# Shipping is a separate line item and is never added to product subtotals.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1000
NEXT_PUBLIC_SHIPPING_FLAT_RATE=60
