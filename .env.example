# ─────────────────────────────────────────────────────────────
# Aether commerce — environment
# Copy this file to .env.local and fill in real sandbox keys.
# The storefront runs fully in mock mode when keys are absent.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, callbacks and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment mode: sandbox | live. Sandbox returns deterministic mock
# responses and never charges a real card.
PAYMENT_MODE=sandbox

# USD → BDT display rate
NEXT_PUBLIC_USD_TO_BDT=120

# Stripe (https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# bKash sandbox (https://developer.bka.sh)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad sandbox (https://developer.nagad.com.bd)
NAGAD_BASE_URL=https://sandbox.mynagad.com
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=

# Optional: set to "1" to log mock payment payloads server-side
PAYMENT_DEBUG=0
